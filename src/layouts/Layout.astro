---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const {
  title = "Data Explorer"
} = Astro.props;
---

<!doctype html>

<html lang="fr">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <meta
      name="description"
      content="Explorations de données réalisées avec Astro et Observable Plot."
    />

    <title>{title}</title>

    <ClientRouter fallback="swap" />

  </head>


  <body class="min-h-screen bg-slate-50 text-slate-900">

    <slot />

  </body>

</html>