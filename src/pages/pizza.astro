---
import * as Plot from "@observablehq/plot";

import { csvParse } from "d3-dsv";

import Layout from "../layouts/Layout.astro";
import PlotFigure from "../components/PlotFigure.astro";

import pizzaCSV from "../data/pizza.csv?raw";


const pizzaRaw = csvParse(pizzaCSV);


const pizza = pizzaRaw.map((row) => ({
  day: row.day_of_week,
  category: row.category,
  name: row.name,
  price: Number(row.price),
  orders: Number(row.orders),
  revenue: Number(row.revenue)
}));


const nombreLignes = pizza.length;

const nombreCategories = new Set(
  pizza.map((row) => row.category)
).size;

const nombrePizzas = new Set(
  pizza.map((row) => row.name)
).size;


const jours = [
  "Monday",
  "Tuesday",
  "Wednesday",
  "Thursday",
  "Friday",
  "Saturday",
  "Sunday"
];
---

<Layout title="Pizza — Data Explorer">

  <main class="mx-auto max-w-6xl px-6 py-16 lg:px-10">

    <a
      href="/"
      class="text-sm font-medium text-slate-500
             hover:text-emerald-700"
    >
      ← Toutes les explorations
    </a>


    <section class="py-20">

      <p
        class="mb-4 text-sm font-bold uppercase tracking-[0.2em]
               text-emerald-700"
      >
        Dataset 03
      </p>

      <h1
        class="text-6xl font-bold tracking-tight text-slate-900
               md:text-8xl"
      >
        Pizza
      </h1>

      <p
        class="mt-6 max-w-2xl text-lg leading-8 text-slate-600"
      >
        Observer les habitudes de commande, les catégories
        et le chiffre d'affaires d'une pizzeria.
      </p>


      <div class="mt-12 grid gap-4 md:grid-cols-3">

        <article class="rounded-2xl bg-slate-900 p-7 text-white">

          <strong class="block text-4xl">
            {nombreLignes}
          </strong>

          <span class="mt-2 block text-slate-400">
            observations
          </span>

        </article>

        <article class="rounded-2xl bg-slate-900 p-7 text-white">

          <strong class="block text-4xl">
            {nombrePizzas}
          </strong>

          <span class="mt-2 block text-slate-400">
            pizzas différentes
          </span>

        </article>

        <article class="rounded-2xl bg-slate-900 p-7 text-white">

          <strong class="block text-4xl">
            {nombreCategories}
          </strong>

          <span class="mt-2 block text-slate-400">
            catégories
          </span>

        </article>

      </div>

    </section>


    <!-- 01 -->

    <section class="py-20">

      <p class="mb-3 font-bold text-emerald-700">
        01 · Chiffre d'affaires
      </p>

      <h2
        class="max-w-3xl text-4xl font-bold tracking-tight
               text-slate-900 md:text-6xl"
      >
        Quelles catégories génèrent le plus de revenus ?
      </h2>


      <div
        class="mt-10 rounded-3xl border border-slate-200
               bg-white p-5 shadow-sm md:p-10"
      >

        <PlotFigure
          options={{
            width: 900,

            title:
              "Revenu par catégorie",

            ariaLabel:
              "Diagramme en barres comparant les revenus générés par chaque catégorie de pizza.",

            x: {
              label: "Catégorie"
            },

            y: {
              label: "Revenu",
              grid: true
            },

            marks: [
              Plot.barY(
                pizza,
                Plot.groupX(
                  {
                    y: "sum"
                  },
                  {
                    x: "category",
                    y: "revenue",
                    fill: "category"
                  }
                )
              )
            ]
          }}
        />

      </div>

    </section>


    <!-- 02 -->

    <section class="py-20">

      <p class="mb-3 font-bold text-emerald-700">
        02 · Jours de la semaine
      </p>

      <h2
        class="max-w-3xl text-4xl font-bold tracking-tight
               text-slate-900 md:text-6xl"
      >
        Quand commande-t-on le plus ?
      </h2>


      <div
        class="mt-10 rounded-3xl border border-slate-200
               bg-white p-5 shadow-sm md:p-10"
      >

        <PlotFigure
          options={{
            width: 900,

            title:
              "Nombre de commandes par jour",

            ariaLabel:
              "Diagramme en barres du nombre de commandes selon le jour de la semaine.",

            x: {
              label: "Jour de la semaine",
              domain: jours
            },

            y: {
              label: "Nombre de commandes",
              grid: true
            },

            marks: [
              Plot.barY(
                pizza,
                Plot.groupX(
                  {
                    y: "sum"
                  },
                  {
                    x: "day",
                    y: "orders"
                  }
                )
              )
            ]
          }}
        />

      </div>

    </section>


    <!-- 03 -->

    <section class="py-20">

      <p class="mb-3 font-bold text-emerald-700">
        03 · Prix et commandes
      </p>

      <h2
        class="max-w-3xl text-4xl font-bold tracking-tight
               text-slate-900 md:text-6xl"
      >
        Le prix influence-t-il le nombre de commandes ?
      </h2>


      <div
        class="mt-10 rounded-3xl border border-slate-200
               bg-white p-5 shadow-sm md:p-10"
      >

        <PlotFigure
          options={{
            width: 900,

            title:
              "Prix et nombre de commandes",

            ariaLabel:
              "Nuage de points comparant le prix des pizzas et le nombre de commandes.",

            x: {
              label: "Prix",
              grid: true
            },

            y: {
              label: "Commandes",
              grid: true
            },

            color: {
              legend: true,
              label: "Catégorie"
            },

            marks: [
              Plot.dot(pizza, {
                x: "price",
                y: "orders",
                fill: "category",
                opacity: 0.65,
                r: 4,
                title: (d) =>
                  `${d.name}\nPrix : ${d.price}\nCommandes : ${d.orders}`
              })
            ]
          }}
        />

      </div>

    </section>

  </main>

</Layout>