---
import * as Plot from "@observablehq/plot";

import { csvParse } from "d3-dsv";

import Layout from "../layouts/Layout.astro";
import PlotFigure from "../components/PlotFigure.astro";

import carsCSV from "../data/cars.csv?raw";


const carsRaw = csvParse(carsCSV);


const cars = carsRaw.map((car) => ({
  name: car.name,
  economy: car["economy (mpg)"]
    ? Number(car["economy (mpg)"])
    : null,
  cylinders: car.cylinders,
  power: car["power (hp)"]
    ? Number(car["power (hp)"])
    : null,
  weight: car["weight (lb)"]
    ? Number(car["weight (lb)"])
    : null
}));


const voituresValides = cars.filter(
  (car) =>
    car.economy !== null &&
    car.power !== null &&
    car.weight !== null
);


const nombreVoitures = cars.length;

const nombreCylindres = new Set(
  cars.map((car) => car.cylinders)
).size;
---

<Layout title="Cars — Data Explorer">

  <main class="mx-auto max-w-6xl px-6 py-16 lg:px-10">

    <a
      href="/"
      class="text-sm font-medium text-slate-500
             hover:text-emerald-700"
    >
      ← Toutes les explorations
    </a>


    <section class="py-20">

      <p
        class="mb-4 text-sm font-bold uppercase tracking-[0.2em]
               text-emerald-700"
      >
        Dataset 02
      </p>

      <h1
        class="text-6xl font-bold tracking-tight text-slate-900
               md:text-8xl"
      >
        Cars
      </h1>

      <p
        class="mt-6 max-w-2xl text-lg leading-8 text-slate-600"
      >
        Explorer les relations entre consommation, puissance,
        cylindrée et poids de différents modèles automobiles.
      </p>


      <div class="mt-12 grid gap-4 md:grid-cols-2">

        <article class="rounded-2xl bg-slate-900 p-7 text-white">

          <strong class="block text-4xl">
            {nombreVoitures}
          </strong>

          <span class="mt-2 block text-slate-400">
            voitures
          </span>

        </article>

        <article class="rounded-2xl bg-slate-900 p-7 text-white">

          <strong class="block text-4xl">
            {nombreCylindres}
          </strong>

          <span class="mt-2 block text-slate-400">
            configurations de cylindres
          </span>

        </article>

      </div>

    </section>


    <!-- 01 -->

    <section class="py-20">

      <p class="mb-3 font-bold text-emerald-700">
        01 · Puissance
      </p>

      <h2
        class="max-w-3xl text-4xl font-bold tracking-tight
               text-slate-900 md:text-6xl"
      >
        Puissance et consommation sont-elles liées ?
      </h2>


      <div
        class="mt-10 rounded-3xl border border-slate-200
               bg-white p-5 shadow-sm md:p-10"
      >

        <PlotFigure
          options={{
            width: 900,

            title:
              "Puissance et consommation",

            subtitle:
              "Chaque point représente un modèle automobile",

            caption:
              "Relation entre la puissance du moteur et la consommation.",

            ariaLabel:
              "Nuage de points comparant la puissance et la consommation des voitures.",

            x: {
              label: "Puissance (hp)",
              grid: true
            },

            y: {
              label: "Économie de carburant (mpg)",
              grid: true
            },

            color: {
              legend: true,
              label: "Cylindres"
            },

            marks: [
              Plot.dot(voituresValides, {
                x: "power",
                y: "economy",
                fill: "cylinders",
                r: 4,
                opacity: 0.75,
                title: (d) =>
                  `${d.name}\n${d.power} hp\n${d.economy} mpg`
              })
            ]
          }}
        />

      </div>

    </section>


    <!-- 02 -->

    <section class="py-20">

      <p class="mb-3 font-bold text-emerald-700">
        02 · Cylindres
      </p>

      <h2
        class="max-w-3xl text-4xl font-bold tracking-tight
               text-slate-900 md:text-6xl"
      >
        Les configurations les plus représentées
      </h2>


      <div
        class="mt-10 rounded-3xl border border-slate-200
               bg-white p-5 shadow-sm md:p-10"
      >

        <PlotFigure
          options={{
            width: 900,

            title:
              "Nombre de voitures par nombre de cylindres",

            ariaLabel:
              "Diagramme en barres du nombre de voitures selon leur nombre de cylindres.",

            x: {
              label: "Nombre de cylindres"
            },

            y: {
              label: "Nombre de voitures",
              grid: true
            },

            marks: [
              Plot.barY(
                cars,
                Plot.groupX(
                  {
                    y: "count"
                  },
                  {
                    x: "cylinders",
                    fill: "cylinders"
                  }
                )
              )
            ]
          }}
        />

      </div>

    </section>


    <!-- 03 -->

    <section class="py-20">

      <p class="mb-3 font-bold text-emerald-700">
        03 · Poids
      </p>

      <h2
        class="max-w-3xl text-4xl font-bold tracking-tight
               text-slate-900 md:text-6xl"
      >
        Le poids selon le nombre de cylindres
      </h2>


      <div
        class="mt-10 rounded-3xl border border-slate-200
               bg-white p-5 shadow-sm md:p-10"
      >

        <PlotFigure
          options={{
            width: 900,

            title:
              "Distribution du poids des voitures",

            ariaLabel:
              "Diagramme en boîte comparant le poids des voitures selon leur nombre de cylindres.",

            x: {
              label: "Nombre de cylindres"
            },

            y: {
              label: "Poids (lb)",
              grid: true
            },

            marks: [
              Plot.boxY(
                voituresValides,
                {
                  x: "cylinders",
                  y: "weight",
                  fill: "cylinders"
                }
              )
            ]
          }}
        />

      </div>

    </section>

  </main>

</Layout>