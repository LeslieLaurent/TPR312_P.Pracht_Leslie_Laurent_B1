---
import * as Plot from "@observablehq/plot";

import Layout from "../layouts/Layout.astro";
import PlotFigure from "../components/PlotFigure.astro";

import penguins from "../data/penguins.json";


const penguinsData = penguins.map(
  ({
    species,
    island,
    culmen_length_mm,
    culmen_depth_mm,
    body_mass_g
  }) => ({
    species,
    island,
    culmen_length_mm,
    culmen_depth_mm,
    body_mass_g
  })
);


const nombrePenguins = penguinsData.length;

const nombreEspeces = new Set(
  penguinsData.map((penguin) => penguin.species)
).size;

const nombreIles = new Set(
  penguinsData.map((penguin) => penguin.island)
).size;
---

<Layout title="Penguins — Data Explorer">

  <main class="mx-auto max-w-6xl px-6 py-16 lg:px-10">

    <a
      href="/"
      class="text-sm font-medium text-slate-500
             hover:text-emerald-700"
    >
      ← Toutes les explorations
    </a>


    <section class="py-20">

      <p
        class="mb-4 text-sm font-bold uppercase tracking-[0.2em]
               text-emerald-700"
      >
        Dataset 01
      </p>

      <h1
        class="text-6xl font-bold tracking-tight text-slate-900
               md:text-8xl"
      >
        Penguins
      </h1>

      <p
        class="mt-6 max-w-2xl text-lg leading-8 text-slate-600"
      >
        Exploration des différences morphologiques entre plusieurs
        espèces de manchots.
      </p>


      <div class="mt-12 grid gap-4 md:grid-cols-3">

        <article class="rounded-2xl bg-slate-900 p-7 text-white">
          <strong class="block text-4xl">
            {nombrePenguins}
          </strong>

          <span class="mt-2 block text-slate-400">
            manchots
          </span>
        </article>

        <article class="rounded-2xl bg-slate-900 p-7 text-white">
          <strong class="block text-4xl">
            {nombreEspeces}
          </strong>

          <span class="mt-2 block text-slate-400">
            espèces
          </span>
        </article>

        <article class="rounded-2xl bg-slate-900 p-7 text-white">
          <strong class="block text-4xl">
            {nombreIles}
          </strong>

          <span class="mt-2 block text-slate-400">
            îles
          </span>
        </article>

      </div>

    </section>


    <!-- 01 -->

    <section class="py-20">

      <p
        class="mb-3 font-bold text-emerald-700"
      >
        01 · Morphologie
      </p>

      <h2
        class="max-w-3xl text-4xl font-bold tracking-tight
               text-slate-900 md:text-6xl"
      >
        La forme du bec distingue les espèces
      </h2>

      <p class="mt-5 max-w-2xl leading-7 text-slate-600">
        Comparaison entre la longueur et la profondeur du bec.
      </p>


      <div
        class="mt-10 rounded-3xl border border-slate-200
               bg-white p-5 shadow-sm md:p-10"
      >

        <PlotFigure
          options={{
            width: 900,

            title:
              "Longueur et profondeur du bec",

            subtitle:
              "Chaque point représente un manchot",

            caption:
              "Comparaison de la morphologie du bec selon l'espèce.",

            ariaLabel:
              "Nuage de points comparant la longueur et la profondeur du bec selon l'espèce.",

            x: {
              label: "Longueur du bec (mm)",
              grid: true
            },

            y: {
              label: "Profondeur du bec (mm)",
              grid: true
            },

            color: {
              legend: true,
              label: "Espèce"
            },

            marks: [
              Plot.dot(penguinsData, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                fill: "species",
                r: 4
              })
            ]
          }}
        />

      </div>

    </section>


    <!-- 02 -->

    <section class="py-20">

      <p class="mb-3 font-bold text-emerald-700">
        02 · Répartition
      </p>

      <h2
        class="max-w-3xl text-4xl font-bold tracking-tight
               text-slate-900 md:text-6xl"
      >
        Combien d'individus par espèce ?
      </h2>


      <div
        class="mt-10 rounded-3xl border border-slate-200
               bg-white p-5 shadow-sm md:p-10"
      >

        <PlotFigure
          options={{
            width: 900,

            title:
              "Nombre de manchots par espèce",

            caption:
              "Répartition des individus dans le dataset.",

            ariaLabel:
              "Diagramme en barres présentant le nombre de manchots par espèce.",

            x: {
              label: "Espèce"
            },

            y: {
              label: "Nombre de manchots",
              grid: true
            },

            marks: [
              Plot.barY(
                penguinsData,
                Plot.groupX(
                  {
                    y: "count"
                  },
                  {
                    x: "species",
                    fill: "species"
                  }
                )
              )
            ]
          }}
        />

      </div>

    </section>


    <!-- 03 -->

    <section class="py-20">

      <p class="mb-3 font-bold text-emerald-700">
        03 · Masse corporelle
      </p>

      <h2
        class="max-w-3xl text-4xl font-bold tracking-tight
               text-slate-900 md:text-6xl"
      >
        Le poids varie selon l'espèce
      </h2>


      <div
        class="mt-10 rounded-3xl border border-slate-200
               bg-white p-5 shadow-sm md:p-10"
      >

        <PlotFigure
          options={{
            width: 900,

            title:
              "Masse corporelle selon l'espèce",

            caption:
              "Distribution de la masse corporelle des différentes espèces.",

            ariaLabel:
              "Diagramme en boîte comparant la masse corporelle des espèces de manchots.",

            x: {
              label: "Espèce"
            },

            y: {
              label: "Masse corporelle (g)",
              grid: true
            },

            marks: [
              Plot.boxY(penguinsData, {
                x: "species",
                y: "body_mass_g",
                fill: "species"
              })
            ]
          }}
        />

      </div>

    </section>

  </main>

</Layout>